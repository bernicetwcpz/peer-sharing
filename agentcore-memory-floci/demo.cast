[0.000, "o", "                                                                                                         │\r\n  │ \u001b[2mCDK bootstrapping is a one-time setup that creates resources CDK needs to deploy stacks.\u001b[22m                                                                                                                                                                                                                                         │\r\n  │ \u001b[2mThis will create a CDKToolkit stack in your AWS account.\u001b[22m                                                                                                                                                                                                                                                                         │\r\n  │                                                                                                                                                                                                                                   "]
