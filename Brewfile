# Install with: brew bundle
# Python is not listed on purpose: uv downloads the version each exercise needs
brew "uv"
brew "node"   # for agentcore-cli (needs >= 20.12)
brew "awscli"

# Container runtime for floci: Colima (no Docker Desktop)
brew "colima", start_service: true # runs at login via brew services; stop: brew services stop colima
brew "docker"
brew "docker-compose"
